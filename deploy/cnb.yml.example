# CNB pipeline config for the CYarp client workspace.
#
# The workspace runs the Native AOT CYarpClient, which dials OUT to your public
# CYarpServer and keeps a long-lived tunnel. The public server forwards
# OpenAI-compatible requests back through that tunnel to the workspace-internal CNB AI
# endpoint:
#
#   public client -> http://<your-domain>/<clientId>/v1/...   (CYarpServer, PROXY_KEY)
#                 -> tunnel
#                 -> CYarpClient (this workspace)
#                 -> https://api.cnb.cool/$CNB_REPO_SLUG/-/ai/...
#
# No <subdomain>-9001.cnb.run is involved: the tunnel dials out, so the drifting
# workspace port-proxy URL is irrelevant.
#
# <clientId> defaults to CNB_REPO_SLUG with "/" replaced by "~" (e.g. org~repo), so
# several workspaces can share one server without colliding.
#
# Required (set in the vscode env: block below, or import from a secrets repo):
#   CYARP_SERVER_URI   your CYarpServer, e.g. ws://ai.example.com
#   PROXY_KEY          public facing API key (also used by keepalive probing)
# Optional:
#   CYARP_CLIENT_ID    client id, default "<org>~<repo>"
#   FIXED_URL          public base of your CYarpServer, e.g. http://ai.example.com.
#                      When set, the keepalive cron probes it and force-recycles a
#                      "fake-alive" workspace (running but tunnel dead).
#
# CNB_TOKEN / CNB_REPO_SLUG are injected by the platform per pipeline run;
# never hardcode them.

# ---------------------------------------------------------------------------
# Platform recycling rules (docs.cnb.cool/zh/workspaces/workspace-recycling):
#   - workspace recycled 10 min after the VS Code page closes (default
#     keepAliveTimeout = 600000 ms) unless keepAliveTimeout is raised;
#   - hard cap ~18h per session; force-recycled 04:00-06:00 after 8h;
#   -> keepAliveTimeout: 18h (below) plus this cron covers all of them.
# The cron itself gets a fresh CNB_TOKEN on every tick (token scope: this repo).
# ---------------------------------------------------------------------------
main:
  "crontab: */5 * * * *":
    - name: keepalive
      docker:
        image: cnbcool/default-dev-env:latest
      env:
        REPO: $CNB_REPO_SLUG
        PROXY_KEY: "CHANGE-ME-your-public-api-key"
        FIXED_URL: "http://ai.example.com"   # set to your CYarpServer base; empty = status check only
      stages:
        - name: ensure-workspace
          script: |
            set -uo pipefail
            API="https://api.cnb.cool"
            CLIENT_ID="${REPO//\//~}"

            # ---- L1: workspace state check --------------------------------
            CODE=$(curl -s --max-time 20 -o /tmp/l.json -w '%{http_code}' "$API/workspace/list?slug=$REPO" -H "Authorization: Bearer $CNB_TOKEN")
            echo "list http=$CODE"
            if [ "$CODE" != "200" ]; then echo "DEGRADED: list http $CODE"; exit 0; fi
            RUNNING=$(jq -r '[(.list // .data // [])[]? | select(.status=="running")][0].sn // empty' /tmp/l.json 2>/dev/null || true)
            if [ -z "$RUNNING" ]; then
              echo "no running workspace -> start"
              curl -s --max-time 60 -X POST "$API/$REPO/-/workspace/start" \
                -H "Authorization: Bearer $CNB_TOKEN" -H "Content-Type: application/json" \
                -d '{"branch":"main"}' | head -c 200; echo
              exit 0
            fi
            echo "workspace running sn=$RUNNING"

            # ---- L2: public endpoint probe (fake-alive detection) ----------
            # /<clientId>/v1/models is answered by CYarpServer itself (no AI quota) and
            # returns 503 while the tunnel is down, so it detects a workspace that is
            # "running" but no longer tunneling.
            # Two consecutive failures -> force recycle = stop + start.
            if [ -z "${FIXED_URL:-}" ]; then echo "no FIXED_URL, status check done"; exit 0; fi
            H1=$(curl -s --max-time 15 -o /dev/null -w '%{http_code}' "$FIXED_URL/$CLIENT_ID/v1/models" -H "Authorization: Bearer $PROXY_KEY" || true)
            if [ "$H1" = "200" ]; then echo "endpoint healthy"; exit 0; fi
            echo "endpoint probe failed ($H1), rechecking in 60s"
            sleep 60
            H2=$(curl -s --max-time 15 -o /dev/null -w '%{http_code}' "$FIXED_URL/$CLIENT_ID/v1/models" -H "Authorization: Bearer $PROXY_KEY" || true)
            if [ "$H2" = "200" ]; then echo "recovered on retry, nothing to do"; exit 0; fi
            echo "still failing ($H2) -> fake-death recovery: stop + start $RUNNING"
            curl -s --max-time 30 -X POST "$API/workspace/stop" \
              -H "Authorization: Bearer $CNB_TOKEN" -H "Content-Type: application/json" \
              -d "{\"sn\":\"$RUNNING\"}" | head -c 120; echo
            sleep 5
            curl -s --max-time 60 -X POST "$API/$REPO/-/workspace/start" \
              -H "Authorization: Bearer $CNB_TOKEN" -H "Content-Type: application/json" \
              -d '{"branch":"main"}' | head -c 200; echo

# ---------------------------------------------------------------------------
# The workspace itself: starts CYarpClient and holds it open.
# ---------------------------------------------------------------------------
$:
  vscode:
    - docker:
        image: cnbcool/default-dev-env:latest
      env:
        CYARP_SERVER_URI: "ws://ai.example.com"
        #CYARP_CLIENT_ID: "org~repo"
      runner:
        cpus: 2
      services:
        - name: vscode
          # Platform default is 10 min without an in-env http/ssh connection;
          # raise to the session cap so the tunnel is what keeps it alive.
          options:
            keepAliveTimeout: 18h
        - docker
      stages:
        - name: start-cyarp-client
          script: |
            set -euo pipefail
            bash "$(pwd)/deploy/cyarp-start.sh"
