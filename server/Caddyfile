# Caddyfile: automatic HTTPS in front of CYarpServer.
# Replace ai.example.com with your own domain; point its DNS A record here first.
ai.example.com {
	encode zstd gzip

	# CYarp tunnels (WebSocket upgrade) and the forwarded API share this vhost.
	reverse_proxy cyarpserver:8080 {
		# Long-lived tunnel connections must not be cut by proxy timeouts.
		transport http {
			read_timeout 0
			write_timeout 0
		}
		flush_interval -1
	}
}