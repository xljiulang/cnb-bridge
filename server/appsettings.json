{
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://+:8080" }
    }
  },
  "CYarpOptions": {
    "Node": "node0",
    "Client": { "KeepAlive": true, "KeepAliveInterval": "00:00:40" },
    "HttpTunnel": { "MaxTunnelsPerClient": 20, "CreationTimeout": "00:00:10" }
  },
  "RedisClientStateStorageOptions": {
    "ConnectionString": ""
  },
  "ProxyKey": "CHANGE-ME-public-api-key",
  "ProxyModels": "deepseek-v4-flash,glm-5.3-flash,kimi-k3",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "CYarp": "Information", "Yarp.ReverseProxy": "Warning", "Microsoft.AspNetCore": "Warning" }
    }
  },
  "AllowedHosts": "*"
}