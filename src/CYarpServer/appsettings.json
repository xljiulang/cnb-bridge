{
  "CYarpOptions": {
    "Node": "node0",
    "Client": {
      "KeepAlive": true,
      "KeepAliveInterval": "00:00:40"
    },
    "HttpTunnel": {
      "MaxTunnelsPerClient": 20,
      "CreationTimeout": "00:00:10"
    }
  },
  "ProxyKey": "CHANGE-ME-public-api-key",
  "ProxyModels": [ "deepseek-v4-flash", "glm-5.3-flash", "kimi-k3" ],
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "CYarp": "Information",
      "Yarp.ReverseProxy": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
