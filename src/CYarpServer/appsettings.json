{
  "CYarpOptions": {
    "Node": "node0",
    "Client": {
      "KeepAlive": true,
      "KeepAliveInterval": "00:00:40"
    },
    "HttpTunnel": {
      "MaxTunnelsPerClient": 20,
      "CreationTimeout": "00:00:10"
    }
  },
  "ApiKey": "CHANGE-ME-public-api-key",
  "ProxyModels": [ "deepseek-v4-flash", "glm-5.3-flash", "kimi-k3" ],
  "AiQuota": {
    "Enabled": true,
    "Interval": "00:02:00",
    "StaleAfter": "00:06:00",
    "MinRemainingCredits": 1,
    "Timeout": "00:00:10"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "CYarp": "Information",
      "Yarp.ReverseProxy": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
