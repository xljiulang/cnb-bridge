<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AssemblyName>CYarpServer</AssemblyName>
    <RootNamespace>CYarpServer</RootNamespace>
    <!-- Bind our own options with the source generator instead of reflection. -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <!--
      The configuration binding source generator cannot generate code for
      CYarp.Server.Configs.HttpTunnelConfig.ActivityHeadersPropagator
      (System.Diagnostics.DistributedContextPropagator is abstract without a public
      constructor), so it reports SYSLIB1100/SYSLIB1101 at the Configure<CYarpOptions> call
      site and handles that subtree through its fallback path. We never configure that
      property; the values we do configure are asserted by the integration tests and echoed
      by the server's startup log.
    -->
    <NoWarn>$(NoWarn);SYSLIB1100;SYSLIB1101</NoWarn>
  </PropertyGroup>

  <!--
    Publish shape: one self contained file that bundles the runtime, trimmed.

    Native AOT is deliberately NOT used here. The CYarp.Server package maps its own
    endpoints with Map(pattern, Delegate); a precompiled library cannot get the source
    generated request delegate, so it falls back to RequestDelegateFactory (expression
    trees), which throws NotSupportedException under Native AOT. Measured: the first
    request to such a server returns 500 and the publish emits IL2026/IL3050.
  -->
  <PropertyGroup>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CYarp.Server" Version="2.0.3" />
    <PackageReference Include="ServiceSelf" Version="1.0.8" />
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The tests assert a couple of internal projections (e.g. the +08:00 normalisation of the tunnel
      creation time) whose bug is invisible on a UTC+8 host through the HTTP surface alone.
    -->
    <InternalsVisibleTo Include="CYarp.Cnb.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

</Project>
