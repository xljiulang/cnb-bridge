{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CNB Bridge",
  "version": "1.0.0",
  "identifier": "cool.cnb.bridge",
  "build": {
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ../ui run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CNB Bridge",
        "width": 1120,
        "height": 760,
        "minWidth": 980,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
